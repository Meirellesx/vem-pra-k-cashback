{
  "name": "Sale",
  "type": "object",
  "properties": {
    "sale_number": {
      "type": "string",
      "title": "N\u00famero da venda"
    },
    "customer_id": {
      "type": "string",
      "title": "ID do cliente"
    },
    "customer_name": {
      "type": "string",
      "title": "Nome do cliente"
    },
    "total_amount": {
      "type": "number",
      "title": "Valor total"
    },
    "eligible_amount": {
      "type": "number",
      "title": "Valor eleg\u00edvel para cashback"
    },
    "cashback_amount": {
      "type": "number",
      "title": "Valor de cashback gerado"
    },
    "cashback_used": {
      "type": "number",
      "title": "Cashback utilizado nesta venda",
      "default": 0
    },
    "payment_method": {
      "type": "string",
      "title": "Forma de pagamento",
      "enum": [
        "dinheiro",
        "cartao_debito",
        "cartao_credito",
        "pix",
        "misto"
      ]
    },
    "sale_date": {
      "type": "string",
      "format": "date",
      "title": "Data da venda"
    },
    "category_id": {
      "type": "string",
      "title": "Categoria"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "concluida",
        "cancelada",
        "devolvida"
      ],
      "default": "concluida"
    },
    "cashback_generated": {
      "type": "boolean",
      "title": "Cashback j\u00e1 gerado",
      "default": false
    },
    "cashback_transaction_id": {
      "type": "string",
      "title": "ID da transa\u00e7\u00e3o de cashback"
    },
    "operator_id": {
      "type": "string",
      "title": "ID do operador"
    },
    "cashier_id": {
      "type": "string",
      "title": "ID do caixa"
    },
    "cancellation_reason": {
      "type": "string",
      "title": "Motivo do cancelamento"
    },
    "is_demo": {
      "type": "boolean",
      "title": "Dados de demonstra\u00e7\u00e3o",
      "default": false
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    },
    "legacy_id": {
      "type": "string",
      "title": "ID no Supabase (espelho)"
    }
  },
  "required": [
    "sale_number",
    "total_amount",
    "payment_method",
    "sale_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "cashier"
          }
        },
        {
          "user_condition": {
            "role": "operador"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "cashier"
          }
        },
        {
          "user_condition": {
            "role": "operador"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    }
  }
}