{
  "name": "CashbackRedemption",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "ID do cliente"
    },
    "customer_name": {
      "type": "string",
      "title": "Nome do cliente"
    },
    "sale_id": {
      "type": "string",
      "title": "ID da venda"
    },
    "sale_number": {
      "type": "string",
      "title": "N\u00famero da venda"
    },
    "amount_redeemed": {
      "type": "number",
      "title": "Valor resgatado"
    },
    "sale_total": {
      "type": "number",
      "title": "Valor total da venda"
    },
    "redemption_date": {
      "type": "string",
      "format": "date",
      "title": "Data do resgate"
    },
    "operator_id": {
      "type": "string",
      "title": "ID do operador"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "ativo",
        "cancelado"
      ],
      "default": "ativo"
    },
    "cancellation_reason": {
      "type": "string",
      "title": "Motivo do cancelamento"
    },
    "transactions_used": {
      "type": "array",
      "title": "Transa\u00e7\u00f5es utilizadas",
      "items": {
        "type": "string"
      }
    },
    "is_demo": {
      "type": "boolean",
      "title": "Dados de demonstra\u00e7\u00e3o",
      "default": false
    },
    "legacy_id": {
      "type": "string",
      "title": "ID no Supabase (espelho)"
    }
  },
  "required": [
    "customer_id",
    "amount_redeemed",
    "sale_total",
    "redemption_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "cashier"
          }
        },
        {
          "user_condition": {
            "role": "operador"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "cashier"
          }
        },
        {
          "user_condition": {
            "role": "operador"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    }
  }
}