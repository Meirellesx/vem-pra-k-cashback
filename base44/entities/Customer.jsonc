{
  "name": "Customer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nome"
    },
    "phone": {
      "type": "string",
      "title": "Telefone"
    },
    "email": {
      "type": "string",
      "title": "E-mail"
    },
    "cpf": {
      "type": "string",
      "title": "CPF"
    },
    "identifier_code": {
      "type": "string",
      "title": "C\u00f3digo de identifica\u00e7\u00e3o"
    },
    "accepts_promotions": {
      "type": "boolean",
      "title": "Aceita comunica\u00e7\u00f5es promocionais",
      "default": false
    },
    "promocoes_opt_in": {
      "type": "boolean",
      "title": "Aceita comunica\u00e7\u00f5es promocionais (n8n/WhatsApp)",
      "default": false
    },
    "cashback_comunicacao_opt_in": {
      "type": "boolean",
      "title": "Aceita mensagens de cashback pelo WhatsApp",
      "default": false
    },
    "data_consentimento": {
      "type": "string",
      "format": "date-time",
      "title": "Data do consentimento"
    },
    "origem_consentimento": {
      "type": "string",
      "title": "Origem do consentimento"
    },
    "opt_out_em": {
      "type": "string",
      "format": "date-time",
      "title": "Data de revoga\u00e7\u00e3o (opt-out)"
    },
    "available_balance": {
      "type": "number",
      "title": "Saldo dispon\u00edvel",
      "default": 0
    },
    "pending_balance": {
      "type": "number",
      "title": "Saldo pendente",
      "default": 0
    },
    "total_cashback_earned": {
      "type": "number",
      "title": "Total cashback gerado",
      "default": 0
    },
    "total_cashback_used": {
      "type": "number",
      "title": "Total cashback utilizado",
      "default": 0
    },
    "is_demo": {
      "type": "boolean",
      "title": "Dados de demonstra\u00e7\u00e3o",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "title": "Ativo",
      "default": true
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    },
    "legacy_id": {
      "type": "string",
      "title": "ID no Supabase (espelho)"
    }
  },
  "required": [
    "name",
    "phone"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "cashier"
          }
        },
        {
          "user_condition": {
            "role": "operador"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    }
  }
}