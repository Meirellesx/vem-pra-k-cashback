{
  "name": "Enviar link de redefini\u00e7\u00e3o para novo cliente",
  "description": "Quando um cliente com e-mail \u00e9 cadastrado (ou tem o e-mail alterado), envia link de defini\u00e7\u00e3o de senha para /reset-password",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Customer",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ ((.trigger.data.email // \"\") != \"\") and (.trigger.data.is_demo != true) and ((.trigger.event_type == \"create\") or (((.trigger.changed_fields // []) | index(\"email\")) != null)) }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "customer_reset_link",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reset_link": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "send-reset-link",
            "args": {
              "email": "${ .trigger.data.email }",
              "full_name": "${ .trigger.data.name }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Enviar link de defini\u00e7\u00e3o de senha",
            "description": "Dispara e-mail de redefini\u00e7\u00e3o para o cliente"
          }
        }
      }
    ]
  }
}