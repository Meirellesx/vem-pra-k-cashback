{
  "name": "Cashback Notify",
  "description": "Cria uma notifica\u00e7\u00e3o in-app para o cliente quando o cashback dele \u00e9 gerado, liberado, expirado ou utilizado. O bot apresenta essas notifica\u00e7\u00f5es quando o cliente abre o chat no WhatsApp.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "CashbackTransaction",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.event_type == \"create\" or (.trigger.event_type == \"update\" and ((.trigger.changed_fields // []) | index(\"status\") != null)) }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "cashback_notify",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "whatsapp-notify",
            "args": {
              "transaction_id": "${ .trigger.entity_id }",
              "event_type": "${ .trigger.event_type }",
              "type": "${ .trigger.data.type }",
              "status": "${ .trigger.data.status }",
              "old_status": "${ .trigger.old_data.status }",
              "customer_id": "${ .trigger.data.customer_id }",
              "customer_name": "${ .trigger.data.customer_name }",
              "amount": "${ .trigger.data.amount }",
              "available_date": "${ .trigger.data.available_date }",
              "expiry_date": "${ .trigger.data.expiry_date }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notificar cliente",
            "description": "Cria notifica\u00e7\u00e3o de cashback (gerado/liberado/expirado/utilizado)"
          }
        }
      }
    ]
  }
}